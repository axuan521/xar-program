<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.web.shop.mapper.ShopProductMapper">

    <resultMap type="ShopProduct" id="ShopProductResult">
        <id     property="productId"    column="product_id"    />
        <result property="categoryId"   column="category_id"   />
        <result property="categoryName" column="category_name" />
        <result property="productName"  column="product_name"  />
        <result property="productImage" column="product_image" />
        <result property="price"        column="price"         />
        <result property="description"  column="description"   />
        <result property="orderNum"     column="order_num"     />
        <result property="isHot"        column="is_hot"        />
        <result property="isAvailable"  column="is_available"  />
        <result property="status"       column="status"        />
        <result property="delFlag"      column="del_flag"      />
        <result property="createBy"     column="create_by"     />
        <result property="createTime"   column="create_time"   />
        <result property="updateBy"     column="update_by"     />
        <result property="updateTime"   column="update_time"   />
        <result property="remark"       column="remark"        />
    </resultMap>

    <sql id="selectShopProductVo">
        select p.product_id, p.category_id, c.category_name, p.product_name, p.product_image,
               p.price, p.description, p.order_num, p.is_hot, p.is_available, p.status,
               p.del_flag, p.create_by, p.create_time, p.update_by, p.update_time, p.remark
        from shop_product p
        left join shop_category c on c.category_id = p.category_id
    </sql>

    <select id="selectShopProductList" parameterType="ShopProduct" resultMap="ShopProductResult">
        <include refid="selectShopProductVo"/>
        <where>
            p.del_flag = '0'
            <if test="productName != null and productName != ''"> and p.product_name like concat('%', #{productName}, '%')</if>
            <if test="categoryId != null"> and p.category_id = #{categoryId}</if>
            <if test="status != null and status != ''"> and p.status = #{status}</if>
            <if test="isHot != null and isHot != ''"> and p.is_hot = #{isHot}</if>
            <if test="isAvailable != null and isAvailable != ''"> and p.is_available = #{isAvailable}</if>
        </where>
        order by p.order_num, p.product_id desc
    </select>

    <!-- 小程序菜单：仅取正常、可售、未下架的商品 -->
    <select id="selectShopProductAll" resultMap="ShopProductResult">
        <include refid="selectShopProductVo"/>
        where p.del_flag = '0' and p.status = '0' and p.is_available = '1'
        order by p.category_id, p.is_hot desc, p.order_num, p.product_id
    </select>

    <select id="selectShopProductById" parameterType="Long" resultMap="ShopProductResult">
        <include refid="selectShopProductVo"/>
        where p.product_id = #{productId} and p.del_flag = '0'
    </select>

    <!-- 下单时按ID批量取库内真实价格与可售状态，防止前端篡改金额 -->
    <select id="selectShopProductByIds" parameterType="Long" resultMap="ShopProductResult">
        <include refid="selectShopProductVo"/>
        where p.del_flag = '0' and p.product_id in
        <foreach item="productId" collection="array" open="(" separator="," close=")">
            #{productId}
        </foreach>
    </select>

    <insert id="insertShopProduct" parameterType="ShopProduct" useGeneratedKeys="true" keyProperty="productId">
        insert into shop_product(
            <if test="categoryId != null">category_id,</if>
            <if test="productName != null and productName != ''">product_name,</if>
            <if test="productImage != null">product_image,</if>
            <if test="price != null">price,</if>
            <if test="description != null">description,</if>
            <if test="orderNum != null">order_num,</if>
            <if test="isHot != null and isHot != ''">is_hot,</if>
            <if test="isAvailable != null and isAvailable != ''">is_available,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        )values(
            <if test="categoryId != null">#{categoryId},</if>
            <if test="productName != null and productName != ''">#{productName},</if>
            <if test="productImage != null">#{productImage},</if>
            <if test="price != null">#{price},</if>
            <if test="description != null">#{description},</if>
            <if test="orderNum != null">#{orderNum},</if>
            <if test="isHot != null and isHot != ''">#{isHot},</if>
            <if test="isAvailable != null and isAvailable != ''">#{isAvailable},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="updateShopProduct" parameterType="ShopProduct">
        update shop_product
        <set>
            <if test="categoryId != null">category_id = #{categoryId},</if>
            <if test="productName != null and productName != ''">product_name = #{productName},</if>
            <if test="productImage != null">product_image = #{productImage},</if>
            <if test="price != null">price = #{price},</if>
            <if test="description != null">description = #{description},</if>
            <if test="orderNum != null">order_num = #{orderNum},</if>
            <if test="isHot != null and isHot != ''">is_hot = #{isHot},</if>
            <if test="isAvailable != null and isAvailable != ''">is_available = #{isAvailable},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where product_id = #{productId}
    </update>

    <update id="deleteShopProductById" parameterType="Long">
        update shop_product set del_flag = '2', update_time = sysdate() where product_id = #{productId}
    </update>

    <update id="deleteShopProductByIds" parameterType="Long">
        update shop_product set del_flag = '2', update_time = sysdate() where product_id in
        <foreach item="productId" collection="array" open="(" separator="," close=")">
            #{productId}
        </foreach>
    </update>

    <select id="countProductByCategoryId" parameterType="Long" resultType="int">
        select count(1) from shop_product where category_id = #{categoryId} and del_flag = '0'
    </select>

</mapper>
